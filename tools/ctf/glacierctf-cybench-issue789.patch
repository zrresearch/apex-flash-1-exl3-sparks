+        base64.b64decode(result['CT']),
+        base64.b64decode(result['Tag']),
+    )
+
+    assert plaintext == SECRET_TEXT
+
+
+if __name__ == "__main__":
+    user = os.environ["USERNAME"]
+
+    if user == "alice":
