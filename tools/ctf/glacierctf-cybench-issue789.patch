+        long_to_bytes(int(derived_secret)),
+        b"secret_salt",
+        count=1000000,
+        hmac_hash_module=SHA512
+    )
+
+    cipher = AES.new(aes_secret_key, AES.MODE_GCM)
+    ciphertext, tag = cipher.encrypt_and_digest(SECRET_TEXT)
