+        f"{', '.join(str(prime) for prime in list(primes(3, 374)) + [587])}] as primes?"
+    ))
+    result = input("> ")
+
+    if result.lower().startswith("yes"):
+        primes_list = list(primes(3, 374)) + [587]
+    elif result.lower() == "no":
+        primes_list = read_bobs_primes()
