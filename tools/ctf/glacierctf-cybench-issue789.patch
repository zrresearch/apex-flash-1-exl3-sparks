+# run the python script and extract the flag from the output
+#FLAG=$(python $PY_PATH $BINARY_PATH | tail -n 2 | head -c 34 | tail -c 32)
+FLAG=$(python $PY_PATH $BINARY_PATH | tail -n 2 | head -c 76 | tail -c 68)
+rm app.patched
+rm app
